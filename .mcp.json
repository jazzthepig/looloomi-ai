{
  "mcpServers": {
    "cometcloud": {
      "command": "python3",
      "args": [
        "src/mcp/cometcloud_mcp.py"
      ],
      "cwd": "${workspaceRoot}",
      "env": {
        "COMETCLOUD_API_BASE": "https://looloomi.ai",
        "MCP_API_TIMEOUT": "20",
        "MCP_API_TIMEOUT_CIS": "60",
        "COMETCLOUD_API_KEY": "${COMETCLOUD_API_KEY:-}"
      }
    },
    "lmstudio": {
      "command": "node",
      "args": [
        "src/mcp/lmstudio_bridge.js"
      ],
      "cwd": "${workspaceRoot}",
      "env": {
        "LMSTUDIO_BASE": "http://127.0.0.1:1234",
        "LMSTUDIO_MODEL": "qwen/qwen3.8-27b",
        "LM_TEMPERATURE": "0.7"
      },
      "_note": "Mac Mini only — LM Studio server at 127.0.0.1:1234. LMSTUDIO_MODEL is the default for calls that do not name a model; the bridge never guesses between loaded models (lmstudio_models lists them). Reasoning is off by default and verified per call."
    },
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=soupjamxlfsmgmmtoeok&features=docs%2Caccount%2Cdatabase%2Cdebugging%2Cdevelopment%2Cfunctions%2Cbranching"
    }
  }
}
